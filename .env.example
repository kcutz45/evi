# Copiar este archivo como .env.local y llenar los valores.
# .env.local está en .gitignore: los valores reales nunca se suben.

# Públicas: llegan al navegador. La clave anon es pública por diseño;
# la seguridad la dan RLS y los privilegios de schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privada: solo la usa el Route Handler /api/categorizar (servidor).
GEMINI_API_KEY=
